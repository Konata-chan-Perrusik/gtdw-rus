							parentanchor = center
							size = { 90 90 }
							texture = "gfx/interface/icons/artifact/artifact_scroll.dds"
							framesize = { 240 240 }
							frame = 1
						}
					}
					container = {
						visible = "[GetScriptedGui('global_masterwork_book_list_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('gh_book_name_flag', MakeScopeFlag(Scope.GetFlagName)).AddScope('book_story', GetPlayer.GetCurrentLocation.MakeScope.Var('gh_search_library_story').Story.MakeScope.Var(Scope.GetFlagName).Story.MakeScope).End)]" #ASKIL NOTE: If collections should be county-based, change value here
