							visible = "[Not(GetScriptedGui('artifact_is_scroll_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('gh_book_name_flag', MakeScopeFlag(Scope.GetFlagName)).End))]"
