							texture = "gfx/interface/icons/artifact/artifact_bg.dds"
							framesize = { 240 240 }
							frame = 3
						}
						icon = {
							visible = "[Not(GetScriptedGui('artifact_is_scroll_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('gh_book_name_flag', MakeScopeFlag(Scope.GetFlagName)).End))]"
							parentanchor = center
							size = { 90 90 }
							texture = "gfx/interface/icons/artifact/artifact_book.dds"
							framesize = { 240 240 }
							frame = 3
						}
						icon = {
							visible = "[GetScriptedGui('artifact_is_scroll_sgui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('gh_book_name_flag', MakeScopeFlag(Scope.GetFlagName)).End)]"
							parentanchor = center
